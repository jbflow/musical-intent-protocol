{
  "name": "musical-intent-protocol",
  "version": "0.3.0",
  "description": "Canonical, versioned specification for the Musical Intent Protocol (MIP).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./v0_3": {
      "types": "./dist/v0_3/index.d.ts",
      "import": "./dist/v0_3/index.js",
      "require": "./dist/v0_3/index.cjs"
    },
    "./v0_2": {
      "types": "./dist/v0_2/index.d.ts",
      "import": "./dist/v0_2/index.js",
      "require": "./dist/v0_2/index.cjs"
    },
    "./v0_1": {
      "types": "./dist/v0_2/index.d.ts",
      "import": "./dist/v0_2/index.js",
      "require": "./dist/v0_2/index.cjs"
    },
    "./schema/mip-0.1.schema.json": "./schema/mip-0.1.schema.json",
    "./schema/mip-0.2.schema.json": "./schema/mip-0.2.schema.json",
    "./schema/mip-0.3.schema.json": "./schema/mip-0.3.schema.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/v0_2/index.ts src/v0_3/index.ts --dts --format esm,cjs --out-dir dist",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
